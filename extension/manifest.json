{
  "manifest_version": 3,
  "name": "Canvas A11y Remediator",
  "version": "1.0.0",
  "description": "Scans and remediates Canvas LMS courses for WCAG 2.1 AA accessibility issues.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://*.canvas.net/*",
    "https://*.canvaslms.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Canvas A11y Remediator",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://*.canvas.net/*",
        "https://*.canvaslms.com/*"
      ],
      "js": [
        "content/scanner.js",
        "content/remediator.js",
        "content/content.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Toggle the Canvas A11y Remediator panel"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
